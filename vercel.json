{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/contact.html", "destination": "/digital-domain/contact", "permanent": true },
    { "source": "/thoughts.html", "destination": "/digital-domain/thoughts", "permanent": true }
  ]
}
